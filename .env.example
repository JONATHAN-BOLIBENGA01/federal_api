# PostgreSQL test/prod database
# Use the Internal Database URL only if the API is hosted on the same provider/network.
# For Aiven PostgreSQL, use the service URI and require SSL like this:
# DATABASE_URL="postgres://avnadmin:<PASSWORD>@pg-1566d294-esisalama-55ad.i.aivencloud.com:27299/defaultdb?sslmode=require"
# If you need full certificate verification, use sslmode=verify-full and provide Aiven's CA certificate.
DATABASE_URL="postgresql://jojo:<PASSWORD>@<HOST>:5432/federaldb?schema=public"

# Frontend origins allowed to call the API.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://federal-frontend-rosy.vercel.app,https://federal-frontend-kwehgy6bw-jonathan-bolibenga01s-projects.vercel.app"
