# PostgreSQL test/prod database
# Use the Internal Database URL only if the API is hosted on the same provider/network.
# Format:
# DATABASE_URL="postgresql://jojo:<PASSWORD>@<HOST>:5432/federaldb?schema=public"
DATABASE_URL="postgresql://jojo:<PASSWORD>@<HOST>:5432/federaldb?schema=public"

# Frontend origins allowed to call the API.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://frontend-federal-rosy.vercel.app"

# One-time admin seed.
ADMIN_EMAIL="admin@lefederal.cd"
ADMIN_NAME="Admin Le Federal"
ADMIN_PASSWORD="<CHANGE_ME>"
